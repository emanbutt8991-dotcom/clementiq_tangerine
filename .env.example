# ─── ClementIQ environment template ─────────────────────────────────────────────────
# Copy to .env and fill in. NEVER commit .env. All keys are read server-side only.

# development | production
CLEMENTIQ_ENV=development

# Database. Omit for local SQLite (data/processed/clementiq.db).
# Tiger Data (Tiger Cloud) example:
# DATABASE_URL=postgresql+psycopg://tsdbadmin:<password>@<service>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
# Local docker TimescaleDB (docker compose --profile local-db up db):
# DATABASE_URL=postgresql+psycopg://clementiq:clementiq-local@db:5432/clementiq
POSTGRES_PASSWORD=clementiq-local

# Public URLs (custom domain, e.g. a GoDaddy Registry domain) — see docs/DEPLOYMENT.md
PUBLIC_WEB_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ─── Auth (change ALL of these in production) ────────────────────────────────────────
JWT_SECRET=dev-only-change-me-dev-only-change-me
JWT_TTL_MINUTES=720
JUDGE_ACCESS_CODE=tangerine-judge
DEMO_CUSTOMER_ACCESS_CODE=tangerine-customer
ADMIN_ACCESS_CODE=tangerine-admin
# Encrypts API keys entered in Settings → Account & Integrations (admin only).
# Optional: if blank, a key is derived from JWT_SECRET. Generate with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
RATE_LIMIT_PER_MINUTE=240
AI_RATE_LIMIT_PER_MINUTE=20

# ─── Clement Gemini (Google AI Studio → Get API key) ────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
# Google Search grounding for WorldPulse research (billing may apply)
GEMINI_GROUNDING=false
# Image model for the optional, consent-based personalised orchard avatar
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Max profile photo upload size in bytes (default 5 MB)
MAX_UPLOAD_BYTES=5242880

# ─── Optional: Snowflake Cortex (Insights second opinion) ───────────────────────────
# SNOWFLAKE_ACCOUNT_URL=https://<org>-<account>.snowflakecomputing.com
# SNOWFLAKE_PAT=<programmatic access token>
SNOWFLAKE_MODEL=mistral-large3
# SQL API warehouse; the token's role needs USAGE on this warehouse.
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# WorldPulse analysis step (Cortex REST chat completions; same account URL + PAT, server-side only).
# Classifies news items and extracts quote-grounded facts. Never produces impact numbers.
# Stays off until SNOWFLAKE_ACCOUNT_URL and SNOWFLAKE_PAT are also set.
SNOWFLAKE_CORTEX_ENABLED=true
CORTEX_MODEL=claude-sonnet-4-6
CORTEX_TIMEOUT_S=45

# ─── WorldPulse providers ───────────────────────────────────────────────────────────
WORLDPULSE_LIVE=true
# Optional keyed providers
NEWS_API_KEY=
ALPHA_VANTAGE_KEY=

# ─── Solana (read-only RPC; Devnet for goal commitments) ────────────────────────────
SOLANA_MAINNET_RPC=https://api.mainnet-beta.solana.com
SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# ─── Optional outbound email (users must opt in) ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alerts@clementiq.local

# ─── Frontend ───────────────────────────────────────────────────────────────────────
API_PROXY_TARGET=http://127.0.0.1:8000
NEXT_PUBLIC_SHOW_DEMO_CODES=true
